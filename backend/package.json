{
  "name": "resume-tailor-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify API that tailors a resume to a job description and serves a 5-minute expiring PDF.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@google/genai": "^2.28.0",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
