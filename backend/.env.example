# Google AI Studio API key (required). Server-side only, never expose to the client.
GEMINI_API_KEY=your_api_key_here

# Gemini model used for tailoring. New projects must use a Gemini 3 model.
GEMINI_MODEL=gemini-3.8-flash

PORT=3001
MAX_FILE_SIZE_MB=5
MIN_JD_LENGTH=100
MAX_JD_LENGTH=6000
MAX_RESUME_TEXT_LENGTH=20000
# Allowed frontend origins, comma-separated (local dev + deployed frontend).
CORS_ORIGIN=http://localhost:3000
DOWNLOAD_TTL_MS=300000
